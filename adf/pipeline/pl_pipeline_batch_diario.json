                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "notebookPath": "/Workspace/Users/eluyo@sintaxis.com.pe/ingest_and_quarantine"
                },
                "linkedServiceName": {
